# ---- قاعدة البيانات (Neon) ----
# DATABASE_URL = الرابط الـ pooled (فيه -pooler) وأضف في آخره: &pgbouncer=true&connect_timeout=15
# DIRECT_URL  = الرابط المباشر (للـ db push) بدون pooler
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# ---- أسرار التوقيع (32 حرف عشوائي على الأقل لكل واحد) ----
ADMIN_JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
API_JWT_SECRET="change-me-to-another-long-random-string-min-32"

# ---- أول مدير (يُستخدم مرة واحدة في db:seed — لا توجد كلمة مرور افتراضية) ----
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_PASSWORD="use-a-strong-password-min-12-chars"

# ---- رمز التأكيد OTP ----
# console = يطبع في الـ Logs (تجريبي). twilio = إرسال SMS حقيقي عبر Twilio REST.
OTP_PROVIDER="console"
# يرجع الرمز في استجابة الـ API (للتجارب فقط! ممنوع في الإنتاج)
OTP_DEBUG="false"
# في الإنتاج يلزم أيضًا ALLOW_OTP_DEBUG="true" حتى يعمل OTP_DEBUG (للتجارب على Vercel فقط، واحذفهما قبل الإطلاق)
ALLOW_OTP_DEBUG="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ---- الدفع ----
# demo = محاكاة (لا تسحب مبالغ). غيّرها بعد ربط بوابة حقيقية في src/lib/payments.ts
PAYMENT_PROVIDER="demo"
# السماح بالدفع التجريبي في الإنتاج (للتجارب فقط!)
ALLOW_DEMO_PAYMENTS="false"

# سر مهمة الـ Cron (رفض العروض المنتهية يوميًا)
CRON_SECRET="change-me-random-string"

# ---- رفع الصور (Vercel Blob) ----
BLOB_READ_WRITE_TOKEN=""

# ---- اختياري ----
APP_BASE_URL="https://your-admin.vercel.app"
